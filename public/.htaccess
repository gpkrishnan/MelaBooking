RewriteEngine On
RewriteBase /gpk/melabooking/

# Serve index.html for root directory access
DirectoryIndex index.html

# If the request doesn't exist as a file or directory, serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L,QSA]
